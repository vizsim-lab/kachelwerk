From fe8e0de1debae584c19a4a1896641248a017694e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 8 Nov 2026 10:30:59 +0000
Subject: [PATCH 1/3] fix(ingest): reproject GeoParquet whose CRS is only in
 the file metadata

The batch reader's schema, after the column projection, has no metadata,
so the second look at the table found no "geo" key and took projected
coordinates for longitude and latitude. Only files that also give the CRS
in a GeoArrow extension type on the geometry column, as GeoPandas writes
them and as the -5070 fixture has it, were reprojected.

The metadata of the full schema is put back on the projected one, and a
test tiles the -5070 lines with the CRS in the "geo" metadata alone.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018JFwoob6fHaD4i2xGpSuk7
---
 src/ingest/arrow.rs |  9 +++++++++
 tests/arrow.rs      | 49 +++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 58 insertions(+)

diff --git a/src/ingest/arrow.rs b/src/ingest/arrow.rs
index 0c2a107..489e35a 100644
--- a/src/ingest/arrow.rs
+++ b/src/ingest/arrow.rs
@@ -105,6 +105,7 @@ pub fn open_parquet(
     let builder =
         ParquetRecordBatchReaderBuilder::try_new(file).map_err(|e| read_error(fname, e))?;
     let full = Table::new(builder.schema(), fname, cfg)?;
+    let metadata = builder.schema().metadata().clone();
     let mask = ProjectionMask::roots(builder.parquet_schema(), full.columns.clone());
     let mut kept = None;
     let mut builder = builder.with_projection(mask).with_batch_size(BATCH_ROWS);
@@ -114,7 +115,15 @@ pub fn open_parquet(
         builder = builder.with_row_groups(groups);
     }
     let reader = builder.build().map_err(|e| read_error(fname, e))?;
+    // The reader's schema has the projected columns without the file's
+    // metadata, where GeoParquet gives the geometry column's CRS, so the
+    // metadata is put back.
     let schema = arrow_array::RecordBatchReader::schema(&reader);
+    let schema = if schema.metadata().is_empty() && !metadata.is_empty() {
+        std::sync::Arc::new(schema.as_ref().clone().with_metadata(metadata))
+    } else {
+        schema
+    };
     Ok((schema, Box::new(reader), kept))
 }
 
diff --git a/tests/arrow.rs b/tests/arrow.rs
index 033b072..a7d1495 100644
--- a/tests/arrow.rs
+++ b/tests/arrow.rs
@@ -163,3 +163,52 @@ fn reprojected_from_another_crs() {
     }
     std::fs::remove_dir_all(&dir).unwrap();
 }
+
+/// The CRS is in the GeoParquet metadata alone, where the GeoParquet
+/// specification puts it, without the GeoArrow extension type on the
+/// geometry column that GeoPandas also writes.
+#[test]
+fn reprojected_from_geoparquet_metadata_alone() {
+    let data = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("tests/arrow");
+    let dir = std::env::temp_dir().join(format!("manby-arrow-geo-crs-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let case = "ne_110m_admin_1_states_provinces_lines";
+    let geo_only = dir.join("geo-only.parquet");
+    {
+        let f = File::open(data.join(format!("{}-5070.parquet", case))).unwrap();
+        let builder = ParquetRecordBatchReaderBuilder::try_new(f).unwrap();
+        let schema = builder.schema().clone();
+        assert!(schema.metadata().contains_key("geo"));
+        let fields: Vec<arrow_schema::Field> = schema
+            .fields()
+            .iter()
+            .map(|f| {
+                f.as_ref()
+                    .clone()
+                    .with_metadata(arrow_schema::Metadata::default())
+            })
+            .collect();
+        let bare = std::sync::Arc::new(arrow_schema::Schema::new_with_metadata(
+            fields,
+            schema.metadata().clone(),
+        ));
+        let out = File::create(&geo_only).unwrap();
+        let mut w = parquet::arrow::ArrowWriter::try_new(out, bare.clone(), None).unwrap();
+        for b in builder.build().unwrap() {
+            let b = b.unwrap();
+            let b = arrow_array::RecordBatch::try_new(bare.clone(), b.columns().to_vec()).unwrap();
+            w.write(&b).unwrap();
+        }
+        w.close().unwrap();
+    }
+    for flags in FLAGS {
+        let lonlat = tile(
+            &data.join(format!("{}.parquet", case)),
+            &dir.join("a.pmtiles"),
+            flags,
+        );
+        let parquet = tile(&geo_only, &dir.join("b.pmtiles"), flags);
+        assert!(parquet == lonlat, "GeoParquet metadata alone {:?}", flags);
+    }
+    std::fs::remove_dir_all(&dir).unwrap();
+}
