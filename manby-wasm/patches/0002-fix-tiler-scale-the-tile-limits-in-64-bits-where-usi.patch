         }
 
         shared_nodes.sort();
@@ -1939,7 +1954,7 @@ pub fn make_tile(octx: &Ctx<'_>, ort: &ReadTile, mp: &MakeParams) -> MakeResult
 
         let mut adjusted_feature_count = feature_count;
         if kept > 0 {
-            adjusted_feature_count = adjusted_feature_count.wrapping_mul(skipped + kept) / kept;
+            adjusted_feature_count = mul_div(adjusted_feature_count, skipped + kept, kept);
         }
 
