 #[derive(Clone, Copy, Debug, PartialEq)]
 pub struct Thresholds {
@@ -1454,22 +1462,25 @@ pub fn make_tile(octx: &Ctx<'_>, ort: &ReadTile, mp: &MakeParams) -> MakeResult
