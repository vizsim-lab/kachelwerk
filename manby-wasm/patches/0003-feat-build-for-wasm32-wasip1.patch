+//! The Unix extension traits tippecanoe-rs and manby use, and their
+//! equivalents on WASI (`wasm32-wasip1`), which reads and writes at offsets
+//! but has no Unix file modes. Everywhere else these are std's own traits.
+
+#[cfg(unix)]
+pub use std::os::unix::ffi::OsStrExt;
+#[cfg(unix)]
+pub use std::os::unix::fs::{FileExt, MetadataExt};
+
+#[cfg(target_os = "wasi")]
+pub use std::os::wasi::ffi::OsStrExt;
+#[cfg(target_os = "wasi")]
+pub use wasi::{FileExt, MetadataExt};
+
+#[cfg(target_os = "wasi")]
+mod wasi {
+    use std::fs::{File, Metadata};
+    use std::io;
+    use std::os::fd::AsRawFd;
+
+    /// `std::os::unix::fs::FileExt`, by way of WASI's `pread` and `pwrite`.
+    pub trait FileExt {
+        fn read_at(&self, buf: &mut [u8], offset: u64) -> io::Result<usize>;
+        fn write_at(&self, buf: &[u8], offset: u64) -> io::Result<usize>;
+
+        fn read_exact_at(&self, mut buf: &mut [u8], mut offset: u64) -> io::Result<()> {
+            while !buf.is_empty() {
+                match self.read_at(buf, offset) {
+                    Ok(0) => {
+                        return Err(io::Error::new(
+                            io::ErrorKind::UnexpectedEof,
+                            "failed to fill whole buffer",
+                        ));
+                    }
+                    Ok(n) => {
+                        buf = &mut buf[n..];
+                        offset += n as u64;
+                    }
+                    Err(e) if e.kind() == io::ErrorKind::Interrupted => {}
+                    Err(e) => return Err(e),
+                }
+            }
+            Ok(())
+        }
+
+        fn write_all_at(&self, mut buf: &[u8], mut offset: u64) -> io::Result<()> {
+            while !buf.is_empty() {
+                match self.write_at(buf, offset) {
+                    Ok(0) => {
+                        return Err(io::Error::new(
+                            io::ErrorKind::WriteZero,
+                            "failed to write whole buffer",
+                        ));
+                    }
+                    Ok(n) => {
+                        buf = &buf[n..];
+                        offset += n as u64;
+                    }
+                    Err(e) if e.kind() == io::ErrorKind::Interrupted => {}
+                    Err(e) => return Err(e),
+                }
+            }
+            Ok(())
+        }
+    }
+
+    impl FileExt for File {
+        fn read_at(&self, buf: &mut [u8], offset: u64) -> io::Result<usize> {
+            // SAFETY: buf is valid for writes of buf.len() bytes.
+            let n = unsafe {
+                libc::pread(
+                    self.as_raw_fd(),
+                    buf.as_mut_ptr().cast(),
+                    buf.len(),
+                    offset as libc::off_t,
+                )
+            };
+            if n < 0 {
+                Err(io::Error::last_os_error())
+            } else {
+                Ok(n as usize)
+            }
+        }
+
+        fn write_at(&self, buf: &[u8], offset: u64) -> io::Result<usize> {
+            // SAFETY: buf is valid for reads of buf.len() bytes.
+            let n = unsafe {
+                libc::pwrite(
+                    self.as_raw_fd(),
+                    buf.as_ptr().cast(),
+                    buf.len(),
+                    offset as libc::off_t,
+                )
+            };
+            if n < 0 {
+                Err(io::Error::last_os_error())
+            } else {
+                Ok(n as usize)
+            }
+        }
+    }
+
+    /// The parts of `std::os::unix::fs::MetadataExt` that are used. WASI has
+    /// no permission bits, so `mode` is only the file type.
+    pub trait MetadataExt {
+        fn size(&self) -> u64;
+        fn mode(&self) -> u32;
+        fn mtime(&self) -> i64;
+        fn mtime_nsec(&self) -> i64;
+        fn ino(&self) -> u64;
+    }
+
+    impl MetadataExt for Metadata {
+        fn size(&self) -> u64 {
+            self.len()
+        }
+
+        fn mode(&self) -> u32 {
+            let t = self.file_type();
+            (if t.is_dir() {
+                libc::S_IFDIR
+            } else if t.is_symlink() {
+                libc::S_IFLNK
+            } else if t.is_file() {
+                libc::S_IFREG
+            } else {
+                0
+            }) as u32
+        }
+
+        fn mtime(&self) -> i64 {
+            since_epoch(self).map_or(0, |d| d.as_secs() as i64)
+        }
+
+        fn mtime_nsec(&self) -> i64 {
+            since_epoch(self).map_or(0, |d| d.subsec_nanos() as i64)
+        }
+
+        fn ino(&self) -> u64 {
+            0
+        }
+    }
+
+    fn since_epoch(m: &Metadata) -> Option<std::time::Duration> {
+        m.modified()
+            .ok()
+            .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
+    }
+}
