+//! The thread pools a run works in.
+
+/// How many threads to work with: `requested`, or for 0 as many as the
+/// machine runs at once. One where threads cannot be started (WASI).
+pub fn thread_count(requested: usize) -> usize {
+    if cfg!(target_os = "wasi") {
+        1
+    } else if requested > 0 {
+        requested
+    } else {
+        std::thread::available_parallelism()
+            .map(|n| n.get())
+            .unwrap_or(1)
+    }
+}
+
+/// A rayon thread pool, or, where threads cannot be started (WASI), none:
+/// the work then runs on the calling thread, and rayon's global pool, which
+/// `par_iter` and the scopes fall back to, is that thread alone.
+pub enum Pool {
+    Rayon(rayon::ThreadPool),
+    Inline,
+}
+
+impl Pool {
+    /// A pool of `threads` threads.
+    pub fn new(threads: usize) -> Result<Pool, rayon::ThreadPoolBuildError> {
+        if cfg!(target_os = "wasi") {
+            // Making the global pool here, where it cannot start threads,
+            // makes it this thread alone, so this thread runs the jobs that
+            // are queued while it waits, or when it yields to rayon.
+            let _ = rayon::current_num_threads();
+            return Ok(Pool::Inline);
+        }
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(threads)
+            .build()
+            .map(Pool::Rayon)
+    }
+
+    /// `rayon::ThreadPool::install`.
+    pub fn install<OP, R>(&self, op: OP) -> R
+    where
+        OP: FnOnce() -> R + Send,
+        R: Send,
+    {
+        match self {
+            Pool::Rayon(pool) => pool.install(op),
+            Pool::Inline => op(),
+        }
+    }
+
+    /// `rayon::ThreadPool::in_place_scope`.
+    pub fn in_place_scope<'scope, OP, R>(&self, op: OP) -> R
+    where
+        OP: FnOnce(&rayon::Scope<'scope>) -> R,
+    {
+        match self {
+            Pool::Rayon(pool) => pool.in_place_scope(op),
+            Pool::Inline => rayon::in_place_scope(op),
+        }
+    }
+}
